# I - Noitcereon - will put any custom path modifications in here.
# Command to add to path is:
# export PATH=/some-path:$PATH
# Make note of the : after some-path and the $ on the second mention of PATH.

NOIT_APPLICATION_HOME="${HOME}/Applications"
# MANUALLY_INSTALLED_DEPENDENCIES is not in use yet, but I figure it could be useful to see which dependencies are manually installed. 
# They should point with symlink to where they are conventionally installed.
# MANUALLY_INSTALLED_DEPENDENCIES="${HOME}/ManuallyInstalledDependencies"

# rider.sh (requires 'JetBrains-Rider' to be a symlink to the installed version to work)
RIDER_BIN_HOME="${NOIT_APPLICATION_HOME}/JetBrains-Rider/bin"
export PATH="${RIDER_BIN_HOME}:${PATH}"

# IntelliJ IDEA (requires 'idea' to be a symlink to the installed version to work)
INTELLIJ_BIN_HOME="${NOIT_APPLICATION_HOME}/idea/bin"
export PATH="${INTELLIJ_BIN_HOME}:${PATH}"

# Java should be added to PATH via the apt package 'update-alternatives'

# dotnet
DOTNET_HOME="${HOME}/.dotnet"
export PATH="${DOTNET_HOME}:${PATH}"

# code (Visual Studio Code)
export PATH="/usr/share/code/code":$PATH
